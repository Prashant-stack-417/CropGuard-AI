{
  "buildCommand": "pip install -r Server/requirements.txt",
  "outputDirectory": "Server",
  "installCommand": "pip install -r Server/requirements.txt",
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "DATABASE_NAME": "cropguard",
    "JWT_SECRET": "@jwt_secret",
    "LOG_LEVEL": "INFO",
    "MODEL_PATH": "Server/model/crop_disease_model.pt",
    "CLASS_MAP_PATH": "Server/model/class_map.json",
    "CORS_ORIGINS": "@cors_origins"
  },
  "functions": {
    "Server/api/index.py": {
      "runtime": "python3.11",
      "memory": 3008,
      "maxDuration": 30
    }
  }
}
